#!/bin/sh
# SPDX-FileCopyrightText: 2026 GoldenGlass contributors
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Stand-in for goldenglass-glass in kcm_apply_test (ctest): stores the level,
# «Reduce transparency» and «Show borders» in $XDG_CONFIG_HOME/goldenglassrc
# like the real tool, without touching the session (Plasma Style, KWin). It
# takes a moment so that requests queue up.
#
# Like kwriteconfig6 it only changes its own key: the rest of the file is
# kept. goldenglass_glass_stub_test checks it.
set -eu
. "$(dirname "$0")/../set_entry.sh"

on_off() {
  case "$1" in
    on) echo true ;;
    off) echo false ;;
    *) echo "goldenglass-glass (test): on or off, not: $1" >&2; exit 2 ;;
  esac
}

case "${1:-}" in
  --level)
    sleep 0.2
    set_entry "${XDG_CONFIG_HOME:?}/goldenglassrc" Glass Level "$2"
    ;;
  --reduce-transparency)
    value=$(on_off "${2:-}")
    sleep 0.2
    set_entry "${XDG_CONFIG_HOME:?}/goldenglassrc" Accessibility ReduceTransparency "$value"
    ;;
  --show-borders)
    value=$(on_off "${2:-}")
    sleep 0.2
    set_entry "${XDG_CONFIG_HOME:?}/goldenglassrc" Accessibility ShowBorders "$value"
    ;;
  --get-refraction) echo unavailable ;;
  --refraction) ;;
  *) echo "goldenglass-glass (prueba): orden desconocida: $*" >&2; exit 2 ;;
esac
