<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0 http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">

  <include>goldenglass_tokens.h</include>

  <kcfgfile name="goldenglassrc" />

  <!-- common options -->
  <group name="Common">

    <!-- shadow strength-->
    <entry name="ShadowStrength" type="Int">
      <default code="true">GoldenGlass::Tokens::ShadowStrength</default>
      <min>25</min>
      <max>255</max>
    </entry>

    <!-- compartida por el estilo y la decoración: un solo valor de fábrica -->
    <entry name="FloatingTitlebar" type = "Bool">
      <default code="true">GoldenGlass::Tokens::FloatingTitlebar</default>
    </entry>

    <!-- GoldenGlass: apps sin barra de título de KWin (app_id de Wayland): el
         estilo pinta los semáforos sobre su barra lateral. Compartido con el
         estilo; solo en las ventanas con menú (las principales). -->
    <entry name="IntegratedTitleBarApps" type="StringList">
      <label>Applications whose main windows draw the window buttons in their toolbar</label>
      <default code="true">QString::fromLatin1(GoldenGlass::Tokens::IntegratedTitleBarApps).split(QLatin1Char(','), Qt::SkipEmptyParts)</default>
    </entry>

    <!-- scrollbar transient -->
    <entry name="ScrollBarTransient" type="Bool">
      <default>false</default>
    </entry>
    <entry name="ScrollBarTransientAlwaysShowSlim" type="Bool">
      <default>false</default>
    </entry>

    <!-- shadow size -->
    <entry name="ShadowSize" type="Enum">
      <choices>
        <choice name="ShadowNone" />
        <choice name="ShadowSmall" />
        <choice name="ShadowMedium" />
        <choice name="ShadowLarge" />
        <choice name="ShadowVeryLarge" />
      </choices>
      <default code="true">GoldenGlass::Tokens::ShadowSize</default>
    </entry>

    <!-- shadow color -->
    <entry name="ShadowColor" type="Color">
      <default code="true">QColor::fromRgba(GoldenGlass::Tokens::ShadowColor)</default>
    </entry>

    <!-- shadow intensity -->
    <entry name="ShadowIntensity" type="Enum">
      <choices>
        <choice name="Low" />
        <choice name="Medium" />
        <choice name="High" />
        <choice name="Maximum" />
      </choices>
      <default>Medium</default>
    </entry>

    <!-- close button -->
    <entry name="OutlineCloseButton" type="Bool">
      <default>false</default>
    </entry>

    <!-- corner radius -->
    <entry name="CornerRadius" type="Int">
      <default code="true">GoldenGlass::Tokens::ControlRadius</default>
      <min>0</min>
      <max>16</max>
    </entry>

    <!-- GoldenGlass: radios por función (px). Compartidos con la decoración. -->
    <entry name="WindowCornerRadius" type="Int">
      <label>Corner radius of windows, in pixels</label>
      <default code="true">GoldenGlass::Tokens::WindowRadius</default>
      <min>0</min>
      <max>32</max>
    </entry>

    <entry name="MenuCornerRadius" type="Int">
      <label>Corner radius of menus and popups, in pixels</label>
      <default code="true">GoldenGlass::Tokens::MenuRadius</default>
      <min>0</min>
      <max>24</max>
    </entry>

    <!-- button size -->
    <entry name="ButtonHeight" type="Int">
      <default>3</default>
    </entry>

    <entry name="ButtonWidth" type="Int">
      <default>1</default>
    </entry>

    <entry name="MenuItemHeight" type="Int">
    <default>4</default>
    </entry>

    <entry name="FancyMargins" type="Bool">
      <default>true</default>
    </entry>
    <entry name="SunkenEffect" type="Bool">
      <default>false</default>
    </entry>
    <entry name="UseNewCheckBox" type="Bool">
      <default>true</default>
    </entry>
  </group>


  <!-- widget style -->
  <group name="Style">

    <!-- animations -->
    <entry name="AnimationsEnabled" type="Bool">
      <default>true</default>
    </entry>

    <entry name="AnimationsDuration" type="Int">
      <default code="true">GoldenGlass::Tokens::StyleAnimationsDuration</default>
    </entry>

    <!-- transition flags -->
    <entry name="StackedWidgetTransitionsEnabled" type="Bool">
      <default>false</default>
    </entry>

    <!-- busy progress bars -->
    <entry name="ProgressBarAnimated" type="Bool">
      <default>true</default>
    </entry>

    <!-- progress bar animation durations -->
    <entry name="ProgressBarBusyStepDuration" type="Int">
      <default code="true">GoldenGlass::Tokens::StyleProgressBarBusyStepDuration</default>
    </entry>

    <!-- scrollbar buttons -->
    <entry name="ScrollBarAddLineButtons" type="Int">
      <default>0</default>
    </entry>

    <entry name="ScrollBarSubLineButtons" type="Int">
      <default>0</default>
    </entry>

    <!-- mnemonics -->
    <entry name="MnemonicsMode" type="Enum">
      <choices>
        <choice name="MN_NEVER" />
        <choice name="MN_AUTO" />
        <choice name="MN_ALWAYS" />
      </choices>
      <default>MN_AUTO</default>
    </entry>

    <!-- toolbars -->
    <entry name="ToolBarDrawItemSeparator" type="Bool">
      <default>false</default>
    </entry>

    <entry name="ToolBarDrawSeparator" type="Bool">
      <default>false</default>
    </entry>

    <!-- views -->
    <entry name="ViewDrawFocusIndicator" type="Bool">
      <default>true</default>
    </entry>

    <!-- shadows on widgets -->
    <entry name="WidgetDrawShadow" type="Bool">
      <default>true</default>
    </entry>

    <!-- shadow underneath toolbar -->
    <entry name="WidgetToolBarShadow" type="Bool">
      <default>false</default>
    </entry>

    <entry name="ScrollableMenu" type="Bool">
      <default>true</default>
    </entry>

    <!-- tree views -->
    <entry name="ViewDrawTreeBranchLines" type="Bool">
      <default>true</default>
    </entry>

    <entry name="ViewInvertSortIndicator" type="Bool">
      <default>false</default>
    </entry>

    <!-- tab bars -->
    <entry name="DocumentModeTabs" type="Bool">
      <default>false</default>
    </entry>

    <entry name="TabBarDrawCenteredTabs" type="Bool">
      <default>false</default>
    </entry>

    <entry name="TabBarTabExpandFullWidth" type="Bool">
      <default>true</default>
    </entry>

    <entry name="TabDrawHighlight" type="Bool">
      <default>false</default>
    </entry>

    <entry name="UnifiedTabBarKonsole" type="Bool">
      <default>false</default>
    </entry>

    <entry name="renderThinSeperatorBetweenTheScrollBar" type="Bool">
      <default>false</default>
    </entry>

    <entry name="TabUseHighlightColor" type="Bool">
      <default>false</default>
    </entry>

    <entry name="DisableDolphinUrlNavigatorBackground" type="Bool">
      <default>true</default>
    </entry>

    <entry name="TabUseBrighterCloseIcon" type="Bool">
      <default>false</default>
    </entry>

    <entry name="TabsHeight" type="Int">
      <default>0</default>
    </entry>

    <!-- frames -->
    <entry name="TitleWidgetDrawFrame" type="Bool">
      <default>false</default>
    </entry>

    <entry name="FullOutline" type="Bool">
      <default>false</default>
    </entry>

    <entry name="NoOutline" type="Bool">
      <default>false</default>
    </entry>

    <entry name="DockWidgetDrawFrame" type="Bool">
      <default>false</default>
    </entry>

    <entry name="KTextEditDrawFrame" type="Bool">
      <default>false</default>
    </entry>

    <entry name="SidePanelDrawFrame" type="Bool">
      <default>false</default>
    </entry>

    <entry name="MenuItemDrawStrongFocus" type="Bool">
      <default>true</default>
    </entry>


    <!-- GoldenGlass: icons next to menu commands (macOS 27 menus are text only) -->

    <entry name="MenuItemIcons" type="Bool">

      <default code="true">GoldenGlass::Tokens::MenuIcons</default>

    </entry>

    <entry name="RoundedRubberBandFrame" type="Bool">
      <default>true</default>
    </entry>

    <!-- window dragging -->
    <entry name="WindowDragMode" type="Enum">
      <choices>
        <choice name="WD_NONE" />
        <choice name="WD_MINIMAL" />
        <choice name="WD_FULL" />
      </choices>
      <default>WD_MINIMAL</default>
    </entry>

    <!--
        this is the comma separated list of special per-app widgets on which
        window dragging can be installed (in addition to the build-in list of
        standard widgets. They are reference by the widget class name.
    -->
    <entry name="WindowDragWhiteList" type="StringList">
      <default></default>
    </entry>

    <!--
        this is the comma separated list of special per-app widgets on which
        window dragging must be disabled (in addition to the build-in list of
        standard widgets). They are reference by the widget class name.
    -->
    <entry name="WindowDragBlackList" type="StringList">
      <default></default>
    </entry>

    <!-- 
        this is the comma separated list of special apps that should have no
        transparency.
    -->
    <entry name="OpaqueApps" type="StringList">
      <default></default>
    </entry>

    <entry name="ForceOpaque" type="StringList">
      <default>kscreenlocker,wine,vlc,kdevelop,smplayer,virtualbox,virtualboxvm,obs,kaffeine,kstars,digikam,kdenlive,zen</default>
    </entry>

    <!-- splitter proxy -->
    <entry name="SplitterProxyEnabled" type="Bool">
      <default>true</default>
    </entry>

    <entry name="SplitterProxyWidth" type="Int">
      <default>12</default>
    </entry>

    <!-- debugging -->
    <entry name="WidgetExplorerEnabled" type="Bool">
      <default>false</default>
    </entry>

    <entry name="DrawWidgetRects" type="Bool">
      <default>false</default>
    </entry>

    <!-- transparency -->
    <entry name="MenuOpacity" type="Int">
      <default code="true">GoldenGlass::Tokens::GlassOpacity</default>
    </entry>

    <entry name="DolphinSidebarOpacity" type="Int">
      <default code="true">GoldenGlass::Tokens::GlassOpacity</default>
    </entry>

    <entry name="DolphinViewOpacity" type="Int">
      <default code="true">GoldenGlass::Tokens::DolphinViewOpacity</default>
    </entry>

    <!-- Deprecated: kept for backwards compatibility migration -->
    <entry name="TransparentDolphinView" type="Bool">
      <default>false</default>
    </entry>

    <entry name="MenuBarOpacity" type="Int">
      <default>100</default>
    </entry>

    <entry name="ToolBarOpacity" type="Int">
      <default code="true">GoldenGlass::Tokens::GlassOpacity</default>
    </entry>

    <entry name="TabBarOpacity" type="Int">
      <default>100</default>
    </entry>

    <entry name="AdjustToDarkThemes" type="Bool">
      <default>false</default>
    </entry>
    <entry name="TabBGColor" type="Color">
      <default>0, 0, 0</default>
    </entry>
  </group>

</kcfg>
