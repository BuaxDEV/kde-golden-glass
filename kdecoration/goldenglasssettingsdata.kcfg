<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0
      http://www.kde.org/standards/kcfg/1.0/kcfg.xsd" >
  <include>goldenglass_tokens.h</include>
  <kcfgfile name="goldenglassrc"/>

  <!-- common options -->
  <group name="Common">

    <entry name="ShadowStrength" type = "Int">
       <default code="true">GoldenGlass::Tokens::ShadowStrength</default>
       <min>25</min>
       <max>255</max>
    </entry>

    <!-- compartida por el estilo y la decoración: un solo valor de fábrica -->
    <entry name="FloatingTitlebar" type = "Bool">
      <default code="true">GoldenGlass::Tokens::FloatingTitlebar</default>
    </entry>

    <!-- GoldenGlass: apps sin barra de título de KWin (app_id de Wayland): el
         estilo pinta los semáforos sobre su barra lateral. Compartido con el
         estilo; solo en las ventanas con menú (las principales). -->
    <entry name="IntegratedTitleBarApps" type="StringList">
      <label>Applications whose main windows draw the window buttons in their toolbar</label>
      <default code="true">QString::fromLatin1(GoldenGlass::Tokens::IntegratedTitleBarApps).split(QLatin1Char(','), Qt::SkipEmptyParts)</default>
    </entry>

    <!-- shadow -->
    <entry name="ShadowSize" type = "Enum">
      <choices>
          <choice name="ShadowNone"/>
          <choice name="ShadowSmall"/>
          <choice name="ShadowMedium"/>
          <choice name="ShadowLarge"/>
          <choice name="ShadowVeryLarge"/>
      </choices>
      <default code="true">GoldenGlass::Tokens::ShadowSize</default>
    </entry>

    <!-- GoldenGlass: sombra de las ventanas sin foco, sin interfaz (se
         cambia con kwriteconfig6). Valores efectivos: min(inactiva, activa),
         y sin sombra activa tampoco hay inactiva (goldenglassshadowparams.h).
         Mismas opciones que ShadowSize: el valor guardado es el mismo nombre
         (ShadowMedium…); el prefijo solo evita repetir el enum. -->
    <entry name="InactiveShadowSize" type = "Enum">
      <choices>
          <choice name="InactiveShadowNone" value="ShadowNone"/>
          <choice name="InactiveShadowSmall" value="ShadowSmall"/>
          <choice name="InactiveShadowMedium" value="ShadowMedium"/>
          <choice name="InactiveShadowLarge" value="ShadowLarge"/>
          <choice name="InactiveShadowVeryLarge" value="ShadowVeryLarge"/>
      </choices>
      <default code="true">GoldenGlass::Tokens::InactiveShadowSize</default>
    </entry>

    <entry name="InactiveShadowStrength" type = "Int">
       <default code="true">GoldenGlass::Tokens::InactiveShadowStrength</default>
       <min>25</min>
       <max>255</max>
    </entry>

    <entry name="ShadowColor" type = "Color">
       <default code="true">QColor::fromRgba(GoldenGlass::Tokens::ShadowColor)</default>
    </entry>

    <!-- close button -->
    <entry name="OutlineCloseButton" type = "Bool">
        <default>false</default>
    </entry>
    
    <!-- corner radius -->
    <entry name="CornerRadius" type = "Int">
      <default code="true">GoldenGlass::Tokens::ControlRadius</default>
      <min>0</min>
      <max>16</max>
    </entry>

    <!-- GoldenGlass: radios por función (px). Compartidos con la decoración. -->
    <entry name="WindowCornerRadius" type="Int">
      <label>Corner radius of windows, in pixels</label>
      <default code="true">GoldenGlass::Tokens::WindowRadius</default>
      <min>0</min>
      <max>32</max>
    </entry>

  </group>

  <group name="Windeco">

    <!-- border size -->
    <!--
      this one is used only for window specific settings, since the default is globally set by kwin
      the enumeration must be kept in sync with kwin's global settings
    -->
    <entry name="BorderSize" type = "Enum">
      <choices>
          <choice name="BorderNone" />
          <choice name="BorderNoSides" />
          <choice name="BorderTiny" />
          <choice name="BorderNormal" />
          <choice name="BorderLarge" />
          <choice name="BorderVeryLarge" />
          <choice name="BorderHuge" />
          <choice name="BorderVeryHuge" />
          <choice name="BorderOversized" />
      </choices>
      <default>BorderNone</default>
    </entry>

    <!-- title alignment -->
    <entry name="TitleAlignment" type="Enum">
      <choices>
          <choice name="AlignLeft" />
          <choice name="AlignCenter" />
          <choice name="AlignCenterFullWidth" />
          <choice name="AlignRight" />
      </choices>
      <default code="true">GoldenGlass::Tokens::TitleAlignment</default>
    </entry>

    <!-- button size -->
    <entry name="ButtonSize" type="Enum">
      <choices>
          <choice name="ButtonTiny" />
          <choice name="ButtonSmall" />
          <choice name="ButtonDefault" />
          <choice name="ButtonLarge" />
          <choice name="ButtonVeryLarge" />
      </choices>
      <default>ButtonDefault</default>
    </entry>

    <!-- maximized windows -->
    <entry name="DrawBorderOnMaximizedWindows" type = "Bool">
        <default>false</default>
    </entry>

    <entry name="DrawTitleBarSeparator" type = "Bool">
        <default>false</default>
    </entry>

    <!-- size grip -->
    <entry name="DrawBackgroundGradient" type = "Bool">
        <default>false</default>
    </entry>
    
    <!-- highlight -->
    <entry name="DrawHighlight" type = "Bool">
      <default>true</default>
    </entry>

    <!-- animations -->
    <entry name="AnimationsEnabled" type = "Bool">
       <default>true</default>
    </entry>

    <entry name="AnimationsDuration" type = "Int">
       <default code="true">GoldenGlass::Tokens::AnimationsDuration</default>
    </entry>

    <!-- hide title bar -->
    <entry name="HideTitleBar" type = "Bool">
       <default>false</default>
    </entry>

    <!-- transparent, blurred title bar (alpha synced to style ToolBarOpacity) -->
    <entry name="BlurTransparentTitleBar" type = "Bool">
       <default code="true">GoldenGlass::Tokens::GlassTitleBar</default>
    </entry>

    <!-- match inactive titlebar to active -->
    <entry name="MatchInactiveTitleBar" type = "Bool">
      <default>false</default>
    </entry>

    <!-- window specific settings -->
    <entry name="ExceptionType" type="Enum">
      <choices>
          <choice name="ExceptionWindowClassName" />
          <choice name="ExceptionWindowTitle" />
      </choices>
      <default>ExceptionWindowClassName</default>
    </entry>

    <entry name="ExceptionPattern" type = "String"/>

    <entry name="Enabled" type = "Bool">
      <default>true</default>
    </entry>

    <entry name="Mask" type = "Int">
      <default>0</default>
    </entry>

    <entry name="OutlineEnabled" type = "Bool">
      <default>false</default>
    </entry>

    <entry name="RoundedCorners" type = "Bool">
      <default>true</default>
    </entry>

  </group>

  <!-- GoldenGlass: accesibilidad (Ajustes › Accesibilidad › Pantalla de macOS),
       compartida con el estilo y la decoración. De fábrica, los tokens
       [accessibility]. Quién escribe y aplica cada clave (F12/F13, pendiente):
       «Accesibilidad» en docs/ARCHITECTURE.md. -->
  <group name="Accessibility">

    <entry name="ShowBorders" type="Bool">
      <default code="true">GoldenGlass::Tokens::AccessibilityShowBorders</default>
    </entry>

    <entry name="ReduceTransparency" type="Bool">
      <default code="true">GoldenGlass::Tokens::AccessibilityReduceTransparency</default>
    </entry>

    <entry name="ReduceMotion" type="Bool">
      <default code="true">GoldenGlass::Tokens::AccessibilityReduceMotion</default>
    </entry>

  </group>

</kcfg>
