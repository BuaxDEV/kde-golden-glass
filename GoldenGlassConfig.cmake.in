@PACKAGE_INIT@

set(GOLDENGLASS_WITH_KDECORATION @WITH_DECORATIONS@)
if(${GOLDENGLASS_WITH_KDECORATION})
    set(GOLDENGLASS_KDECORATION_PLUGIN_ID "org.goldenglass.decoration")
else()
    set(GOLDENGLASS_KDECORATION_PLUGIN_ID "")
endif()

set(GOLDENGLASS_STYLE_NAME "goldenglass")
