"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=n != 1;\n"

msgctxt "@info:status"
msgid "The glass level could not be applied: %1"
msgstr "No se pudo aplicar el nivel de vidrio: %1"

msgctxt "@info:status"
msgid "goldenglass-glass could not be started: %1"
msgstr "No se pudo iniciar goldenglass-glass: %1"

msgctxt "@info:status"
msgid "goldenglass-glass was not found. Is the goldenglass-kstyle package installed?"
msgstr "No se encontró goldenglass-glass. ¿Está instalado el paquete goldenglass-kstyle?"

msgctxt "@label:slider"
msgid "Glass:"
msgstr "Vidrio:"

msgctxt "@label:slider"
msgid "Glass"
msgstr "Vidrio"

msgctxt "@item:inrange glass level"
msgid "Clearer"
msgstr "Más claro"

msgctxt "@item:inrange glass level"
msgid "Default"
msgstr "Predeterminado"

msgctxt "@item:inrange glass level"
msgid "More opaque"
msgstr "Más opaco"

msgctxt "@info:status"
msgid "Applying…"
msgstr "Aplicando…"

msgctxt "@info"
msgid ""
"Changes the glass of the menu bar, the dock, popups, window title bars, "
"toolbars, sidebars and menus. A clearer glass shows more of what is behind; "
"a more opaque glass is easier to read."
msgstr ""
"Cambia el vidrio de la barra de menús, el dock, los popups, las barras de "
"título, las toolbars, las barras laterales y los menús. Un vidrio más claro "
"deja ver más lo que hay detrás; uno más opaco se lee mejor."

msgctxt "@info:status"
msgid "Refraction could not be changed: %1"
msgstr "No se pudo cambiar la refracción: %1"

msgctxt "@label"
msgid "Refraction:"
msgstr "Refracción:"

msgctxt "@option:check"
msgid "Bend the background at the edges of the glass"
msgstr "Curvar el fondo en los bordes del vidrio"

msgctxt "@info"
msgid "Like Liquid Glass: the dock, menu bar and popups bend what is behind them, more with clearer glass. Turn it off if the graphics card struggles."
msgstr "Como Liquid Glass: el dock, la barra de menús y los menús emergentes curvan lo que tienen detrás, más cuanto más claro es el vidrio. Desactívala si la tarjeta gráfica va justa."

msgctxt "@info"
msgid "Not available: KWin did not load the GoldenGlass effect. Rebuild goldenglass-kstyle after updating KWin."
msgstr "No disponible: KWin no cargó el efecto de GoldenGlass. Vuelve a compilar goldenglass-kstyle tras actualizar KWin."

msgctxt "@label"
msgid "Menu bar:"
msgstr "Barra de menús:"

msgctxt "@option:check"
msgid "Show menu bar background"
msgstr "Mostrar fondo de la barra de menús"

msgctxt "@info"
msgid "Off, like macOS: the menu bar is drawn straight over the wallpaper. On: a strip of glass behind it."
msgstr "Desactivado, como en macOS: la barra de menús se dibuja directamente sobre el fondo de pantalla. Activado: lleva detrás una franja de vidrio."

msgctxt "@info:status"
msgid "Reduce motion could not be changed: %1"
msgstr "No se pudo cambiar «Reducir movimiento»: %1"

msgctxt "@info:status"
msgid "goldenglass-windows could not be started: %1"
msgstr "No se pudo iniciar goldenglass-windows: %1"

msgctxt "@info:status"
msgid "goldenglass-windows was not found. Is the goldenglass-plasma package installed?"
msgstr "No se encontró goldenglass-windows. ¿Está instalado el paquete goldenglass-plasma?"

msgctxt "@label"
msgid "Accessibility:"
msgstr "Accesibilidad:"

msgctxt "@option:check"
msgid "Reduce motion"
msgstr "Reducir movimiento"

msgctxt "@info"
msgid "Windows, the dock and panels fade in and out instead of zooming, sliding or bouncing."
msgstr "Las ventanas, el dock y los paneles aparecen y desaparecen con un fundido en lugar de ampliarse, deslizarse o rebotar."

msgctxt "@info:status"
msgid "Reduce transparency could not be changed: %1"
msgstr "No se pudo cambiar «Reducir transparencia»: %1"

msgctxt "@option:check"
msgid "Reduce transparency"
msgstr "Reducir transparencia"

msgctxt "@info"
msgid "The menu bar, the dock, popups, title bars, toolbars, sidebars and menus become opaque, without blur or refraction. The glass level is kept for when you turn it off."
msgstr "La barra de menús, el dock, los popups, las barras de título, las barras de herramientas, las barras laterales y los menús se vuelven opacos, sin difuminado ni refracción. El nivel de vidrio se conserva para cuando lo desactives."

msgctxt "@info"
msgid "Turned off by Reduce transparency"
msgstr "Desactivado por Reducir transparencia"

msgctxt "@info:status"
msgid "Show borders could not be changed: %1"
msgstr "No se pudo cambiar «Mostrar bordes»: %1"

msgctxt "@option:check"
msgid "Show borders"
msgstr "Mostrar bordes"

msgctxt "@info"
msgid "Buttons, text fields, toolbar buttons, windows and the glass of the menu bar, the dock and popups get a thin border that sets them apart from what is behind."
msgstr "Los botones, los campos de texto, los botones de las barras de herramientas, las ventanas y el vidrio de la barra de menús, el dock y los popups llevan un borde fino que los separa de lo que hay detrás."
