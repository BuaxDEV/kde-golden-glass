msgstr "Tamaño"

msgctxt "@item:inrange dock size"
msgid "Small"
msgstr "Pequeño"

msgctxt "@item:inrange dock size"
msgid "Large"
msgstr "Grande"

msgctxt "@label"
msgid "Magnification:"
msgstr "Ampliación:"

msgctxt "@option:check"
msgid "Enlarge icons under the pointer"
msgstr "Agrandar los iconos bajo el puntero"

msgctxt "@label:slider"
msgid "Magnification size"
msgstr "Tamaño de la ampliación"

msgctxt "@item:inrange magnification"
msgid "Small"
msgstr "Mínima"

