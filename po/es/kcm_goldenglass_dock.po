msgctxt "@info:status"
msgid "The dock settings could not be applied: %1"
msgstr "No se pudieron aplicar los ajustes del dock: %1"

msgctxt "@info:status"
msgid "goldenglass-dock could not be started: %1"
msgstr "No se pudo iniciar goldenglass-dock: %1"

msgctxt "@info:status"
msgid "goldenglass-dock was not found. Is the goldenglass-plasma package installed?"
msgstr "No se encontró goldenglass-dock. ¿Está instalado el paquete goldenglass-plasma?"

msgctxt "@info"
msgid "There is no GoldenGlass dock in the panels. Apply a GoldenGlass global theme with “Desktop and window layout” checked to add it."
msgstr "No hay ningún dock de GoldenGlass en los paneles. Para añadirlo, aplica un tema global de GoldenGlass con «Disposición del escritorio y ventanas» marcada."

msgctxt "@label:slider"
msgid "Size:"
msgstr "Tamaño:"

msgctxt "@label:slider"
