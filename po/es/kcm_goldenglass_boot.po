msgid ""
msgstr ""
"Project-Id-Version: kcm_goldenglass_boot\n"
"Language: es\n"
"PO-Revision-Date: 2026-10-12 18:00+0000\n"
"Last-Translator: GoldenGlass contributors\n"
"Language-Team: Spanish\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=n != 1;\n"

msgctxt "@info:status"
msgid "Nothing was changed: authentication was canceled or denied."
msgstr "No se cambió nada: se canceló o denegó la autenticación."

msgctxt "@info:status"
msgid "The change could not be applied: %1"
msgstr "No se pudo aplicar el cambio: %1"

msgctxt "@info:status"
msgid "goldenglass-system could not be started: %1"
msgstr "No se pudo iniciar goldenglass-system: %1"

msgctxt "@info:status"
msgid "goldenglass-system was not found. Is the goldenglass-plasma package installed?"
msgstr "No se encontró goldenglass-system. ¿Está instalado el paquete goldenglass-plasma?"

msgctxt "@info:status"
msgid "The current state could not be read: %1"
msgstr "No se pudo leer el estado actual: %1"

msgctxt "@info"
msgid "The GoldenGlass boot screens are not installed (goldenglass-plymouth package)."
msgstr "Las pantallas de arranque de GoldenGlass no están instaladas (paquete goldenglass-plymouth)."

msgctxt "@info"
msgid "The kernel command line has no “splash” option: no boot screen will be shown."
msgstr "La línea de comandos del kernel no tiene la opción «splash»: no se mostrará ninguna pantalla de arranque."

msgctxt "@info"
msgid "The “plymouth” hook is missing from the mkinitcpio HOOKS: no boot screen will be shown."
msgstr "Falta el hook «plymouth» en HOOKS de mkinitcpio: no se mostrará ninguna pantalla de arranque."

msgctxt "@info"
msgid "/etc/sddm.conf sets its own theme and takes precedence: the GoldenGlass login screen will not be shown."
msgstr "/etc/sddm.conf fija su propio tema y tiene prioridad: no se verá la pantalla de inicio de sesión de GoldenGlass."

msgctxt "@label"
msgid "Boot screen:"
msgstr "Pantalla de arranque:"

msgctxt "@option:radio boot screen"
msgid "System"
msgstr "Del sistema"

msgctxt "@option:radio boot screen"
msgid "GoldenGlass"
msgstr "GoldenGlass"

msgctxt "@option:radio boot screen"
msgid "GoldenGlass Light"
msgstr "GoldenGlass gris"

msgctxt "@info"
msgid "The logo and a thin progress bar while the computer starts, and the disk password, if it is encrypted, in a glass field. Applying rebuilds the initramfs, which takes a moment."
msgstr "El logo y una barra de progreso fina mientras arranca el equipo y, si el disco está cifrado, su contraseña en un campo de vidrio. Al aplicar se regenera el initramfs, lo que tarda un momento."

msgctxt "@label"
msgid "Login screen:"
msgstr "Pantalla de inicio de sesión:"

msgctxt "@option:check"
msgid "Use the GoldenGlass login screen"
msgstr "Usar la pantalla de inicio de sesión de GoldenGlass"

msgctxt "@option:check"
msgid "Use the GoldenGlass wallpaper and my Plasma settings"
msgstr "Usar el fondo de GoldenGlass y mis ajustes de Plasma"

msgctxt "@info"
msgid "Like the lock screen: blurred day or night wallpaper, large clock, avatar and password."
msgstr "Como la pantalla de bloqueo: fondo de día o de noche difuminado, reloj grande, avatar y contraseña."

msgctxt "@info"
msgid "The GoldenGlass SDDM theme is not installed (goldenglass-login package)."
msgstr "El tema de SDDM de GoldenGlass no está instalado (paquete goldenglass-login)."

msgctxt "@info"
msgid "Plasma Login Manager does not support themes: it gets the GoldenGlass wallpaper and copies your colors, Plasma style, fonts, cursor and keyboard layout. For the full GoldenGlass login screen, use SDDM."
msgstr "Plasma Login Manager no admite temas: recibe el fondo de GoldenGlass y una copia de tus colores, estilo de Plasma, fuentes, cursor y distribución de teclado. Para la pantalla de inicio de sesión completa de GoldenGlass, usa SDDM."

msgctxt "@info"
msgid "The GoldenGlass wallpaper is not installed (goldenglass-wallpapers package)."
msgstr "El fondo de GoldenGlass no está instalado (paquete goldenglass-wallpapers)."

msgctxt "@info"
msgid "The login manager in use is not SDDM or Plasma Login Manager: GoldenGlass cannot change its screen."
msgstr "El gestor de inicio de sesión no es SDDM ni Plasma Login Manager: GoldenGlass no puede cambiar su pantalla."

msgctxt "@info:status"
msgid "Applying…"
msgstr "Aplicando…"

msgctxt "@info"
msgid "Applying asks for the administrator password."
msgstr "Al aplicar se pide la contraseña de administrador."
